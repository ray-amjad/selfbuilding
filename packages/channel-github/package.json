  "author": "Ray Amjad",
  "keywords": [
    "selfbuilding",
    "github",
    "github-app",
    "pull-request"
  ],
  "homepage": "https://github.com/ray-amjad/selfbuilding/tree/main/packages/channel-github#readme",
  "bugs": "https://github.com/ray-amjad/selfbuilding/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ray-amjad/selfbuilding.git",
    "directory": "packages/channel-github"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
