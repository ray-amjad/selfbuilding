{
  "name": "@selfbuilding/sandbox-e2b",
  "version": "0.1.0",
  "description": "E2B sandbox provider and the shared E2B-shape adapter.",
  "license": "MIT",
  "author": "Ray Amjad",
  "keywords": [
    "selfbuilding",
    "e2b",
    "sandbox"
  ],
  "homepage": "https://github.com/ray-amjad/selfbuilding/tree/main/packages/sandbox-e2b#readme",
  "bugs": "https://github.com/ray-amjad/selfbuilding/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ray-amjad/selfbuilding.git",
    "directory": "packages/sandbox-e2b"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
