  },
  "scripts": {
    "build": "tsup && tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@selfbuilding/core": "workspace:*",
    "e2b": "^2.62.0",
    "@selfbuilding/images": "workspace:*"
  },
  "devDependencies": {
    "@selfbuilding/sandbox-conformance": "workspace:*",
    "@selfbuilding/testing": "workspace:*"
  }
