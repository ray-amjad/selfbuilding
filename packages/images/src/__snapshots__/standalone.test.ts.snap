// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`toStandaloneDockerfile (release-prep §4.1) > matches the snapshot for all-harnesses 1`] = `
"# Generated from @selfbuilding/images (standalone: one FROM, no ARG). Do not edit by hand.
FROM node:22-bookworm-slim
USER root
SHELL ["/bin/sh", "-euc"]
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update \\
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg git jq ripgrep build-essential unzip python3 procps coreutils \\
  && install -d -m 0755 /etc/apt/keyrings \\
  && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \\
  && chmod 0644 /etc/apt/keyrings/githubcli-archive-keyring.gpg \\
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \\
  && apt-get update \\
  && apt-get install -y --no-install-recommends gh \\
  && rm -rf /var/lib/apt/lists/*
RUN npm --userconfig=/dev/null --ignore-scripts=false install --global --prefix /usr/local pnpm@12.16.1 bun@1.4.4
RUN userdel --remove node 2>/dev/null || true \\
  && { getent group "1000" >/dev/null || groupadd --gid "1000" agent; } \\
  && useradd --uid "1000" --gid "1000" --create-home --home-dir /home/agent --shell /bin/bash agent
RUN sh -euc "$(echo  | base64 -d)"
RUN node --version && git --version && gh --version && timeout --version >/dev/null
ENV DISABLE_AUTOUPDATER=1
RUN npm --userconfig=/dev/null --ignore-scripts=false install --global --prefix /usr/local @anthropic-ai/claude-code@2.1.316
RUN npm --userconfig=/dev/null --ignore-scripts=false install --global --prefix /usr/local @openai/codex@0.166.0
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/selfbuilding/browsers NODE_PATH=/usr/local/lib/node_modules
RUN apt-get update \\
  && apt-get install -y --no-install-recommends sqlite3 \\
  && npm --userconfig=/dev/null --ignore-scripts=false install --global --prefix /usr/local playwright@1.64.1 @playwright/mcp@0.0.83 \\
  && /usr/local/bin/playwright install --with-deps chromium \\
  && node /usr/local/lib/node_modules/@playwright/mcp/node_modules/playwright-core/cli.js install chromium \\
  && rm -rf /var/lib/apt/lists/* \\
  && chmod -R a+rX /opt/selfbuilding/browsers
RUN sh -euc "$(echo  | base64 -d)"
RUN sh -euc "$(echo  | base64 -d)"
RUN /usr/local/bin/claude --version && /usr/local/bin/codex --version && /usr/local/bin/playwright-mcp --version && cd /selfbuilding/out && runuser -u agent -- env -i HOME=/selfbuilding/home PATH=/usr/local/bin:/usr/bin:/bin node -e "require('playwright')" && runuser -u agent -- env -i HOME=/selfbuilding/home PATH=/usr/local/bin:/usr/bin:/bin node --input-type=module -e "const { chromium } = await import('playwright'); const b = await chromium.launch({ args: ['--no-sandbox'] }); await b.close();" && runuser -u agent -- env -i HOME=/selfbuilding/home PATH=/usr/local/bin:/usr/bin:/bin node -e "require('/usr/local/lib/node_modules/@playwright/mcp/node_modules/playwright-core').chromium.launch({ args: ['--no-sandbox'] }).then((b) => b.close()).catch((e) => { console.error(e); process.exit(1); });"
WORKDIR /selfbuilding/work
LABEL org.opencontainers.image.title="selfbuilding-all-harnesses"
"
`;

